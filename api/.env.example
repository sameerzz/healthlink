# Copy this file to api/.env and replace the placeholders with your own values.
# Never commit your .env file or share credentials.

# Choose MODEL_PROVIDER and MODEL_NAME in api/config.py.
# Fill in only the key for your chosen provider; leave the others empty.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Gemini accepts either key name. GEMINI_API_KEY takes precedence if both are set.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Backward-compatible OpenRouter model fallback when MODEL_NAME is not set directly.
OPENROUTER_MODEL=

# Required: Redis connection URL. This example uses a local Redis server.
# For hosted Redis with TLS, use rediss://default:your-password@your-host:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional: override the default SQLite database at api/data/healthlink.db.
# DATABASE_PATH=/absolute/path/to/healthlink.db
